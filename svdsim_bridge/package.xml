<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>svdsim_bridge</name>
  <version>1.0.0</version>
  <description>Monaco F1TENTH simulation bridge providing bidirectional communication between ZMQ/protobuf simulation server and ROS 2 topics</description>
  <maintainer email="glpuga@ekumenlabs.com">Gerardo Puga</maintainer>
  <license>Apache-2.0</license>
  <author email="glpuga@ekumenlabs.com">Gerardo Puga</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>svdsim_msgs</depend>
  <depend>svdsim_proto</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
